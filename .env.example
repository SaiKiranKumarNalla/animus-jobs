# Copy to .env and fill in. This file stays on your Mac; never commit .env.

# --- Email alerts (Gmail) -------------------------------------------------
# Create an app password: https://myaccount.google.com/apppasswords  (needs 2-Step Verification)
SMTP_USER=you@example.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=you@example.com

# --- AI agents (any subset works) -----------------------------------------
# Claude: either log in the CLI once (`claude` then /login), or set an API key:
ANTHROPIC_API_KEY=
# Optional explicit paths if the CLIs are not on PATH:
# CLAUDE_BIN=
# CODEX_BIN=
# GEMINI_BIN=
# Gemini without the CLI (https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# --- Extra job sources (optional, free) ----------------------------------
# France Travail "Offres d'emploi v2": https://francetravail.io → create an app → subscribe to "API Offres d'emploi"
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# https://developer.adzuna.com/  (covers France, UK, US, DE, ...)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
